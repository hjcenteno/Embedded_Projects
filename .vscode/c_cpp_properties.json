{
    "configurations": [
        {
            "name": "STM32G474",
            "includePath": [
                "${workspaceFolder}/lib",
                "${env:HOME}/cmsis_core/CMSIS/Core/Include",
                "${env:HOME}/cmsis_device_g4/Include"
            ],
            "defines": ["STM32G474xx"],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": ["-mcpu=cortex-m4", "-mthumb", "-mfpu=fpv4-sp-d16", "-mfloat-abi=hard"],
            "cStandard": "gnu23",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}